# Required: shared bearer token. Generate with: openssl rand -hex 32
INDEXEDCODE_WORKER_SECRET=

# Pool sizes (containers per stage). Each loads its own copy of the model.
SUMMARY_WORKERS=3
EMBEDDING_WORKERS=2

# Gateway ports on the host (summary, embedding) and bind address.
SUMMARY_PORT=8801
EMBEDDING_PORT=8802
BIND_ADDRESS=127.0.0.1

# Numeric GIDs of the host's `video` and `render` groups (GPU device access):
#   getent group video render
VIDEO_GID=44
RENDER_GID=109

# GGUF models, "repo_id:filename-glob" or a local .gguf path such as
# /models/my-model.gguf (drop the file into the `models` volume first:
# docker run --rm -v indexedcode-inference_models:/to -v $PWD:/from \
#   alpine cp /from/my-model.gguf /to/). If you change a model, set the
# same `model` for the stage in indexedcode.toml (setup UI: Model field).
# SUMMARY_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct-GGUF:*q8_0.gguf
# EMBEDDING_MODEL=second-state/All-MiniLM-L6-v2-Embedding-GGUF:*Q8_0.gguf

# KV-cache context window per summary worker (tokens). Keep at or below the
# model's trained maximum — the defaults above are 32768 and 512.
# INDEXEDCODE_N_CTX=4096

# Optional TLS front (docker compose --profile tls up -d): serves
# https://$TLS_HOST:8443 (summary) and :8444 (embedding). Put a real
# certificate pair certs/$TLS_HOST.{crt,key} — e.g. from
# `tailscale cert <host>.<tailnet>.ts.net` — and set the hostname here.
# TLS_HOST=host.tailnet.ts.net
# TLS_BIND_ADDRESS=0.0.0.0

